<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>PRAMUNIAGA CENTER</title>

  <style>

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f7fb;
      color: #1f2937;
    }

    body {
      overflow: hidden;
    }


    /* =====================================================
       MAIN LAYOUT
    ===================================================== */

    .app {
      display: flex;
      width: 100%;
      height: 100vh;
    }


    /* =====================================================
       SIDEBAR DESKTOP
    ===================================================== */

    .sidebar {
      width: 250px;
      height: 100vh;
      background: #075dcc;
      color: white;
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
    }

    .brand {
      padding: 28px 22px 23px;
      border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    .brand-title {
      font-size: 25px;
      font-weight: 800;
      letter-spacing: 0.5px;
    }

    .brand-subtitle {
      margin-top: 6px;
      font-size: 12px;
      opacity: 0.85;
    }

    .menu {
      padding: 20px 12px;
      flex: 1;
    }

    .menu-title {
      font-size: 11px;
      text-transform: uppercase;
      opacity: 0.65;
      margin: 0 12px 10px;
      letter-spacing: 1px;
    }

    .menu button {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 13px;
      border: none;
      background: transparent;
      color: white;
      padding: 13px 14px;
      margin-bottom: 5px;
      border-radius: 10px;
      cursor: pointer;
      font-size: 14px;
      text-align: left;
      transition: 0.2s;
    }

    .menu button:hover {
      background: rgba(255,255,255,0.12);
    }

    .menu button.active {
      background: white;
      color: #075dcc;
      font-weight: 700;
    }

    .menu-icon {
      width: 25px;
      text-align: center;
      font-size: 18px;
    }

    .sidebar-footer {
      padding: 16px 20px;
      font-size: 11px;
      opacity: 0.7;
      border-top: 1px solid rgba(255,255,255,0.15);
    }


    /* =====================================================
       MAIN
    ===================================================== */

    .main {
      flex: 1;
      min-width: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
    }


    /* =====================================================
       HEADER
    ===================================================== */

    .header {
      height: 70px;
      background: white;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 25px;
      border-bottom: 1px solid #e5e7eb;
      flex-shrink: 0;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .header-icon {
      font-size: 24px;
    }

    .header-title {
      font-size: 18px;
      font-weight: 700;
    }

    .header-right {
      font-size: 13px;
      color: #6b7280;
    }


    /* =====================================================
       HOME
    ===================================================== */

    .content {
      flex: 1;
      overflow: auto;
      padding: 30px;
    }

    .welcome {
      margin-bottom: 28px;
    }

    .welcome h1 {
      margin: 0;
      font-size: 28px;
      color: #111827;
    }

    .welcome p {
      margin: 8px 0 0;
      color: #6b7280;
      font-size: 14px;
    }

    .section-title {
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 15px;
    }


    /* =====================================================
       CARDS
    ===================================================== */

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .card {
      background: white;
      border-radius: 15px;
      padding: 22px;
      border: 1px solid #e5e7eb;
      cursor: pointer;
      transition: 0.2s;
      min-height: 200px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .card-icon {
      width: 52px;
      height: 52px;
      border-radius: 13px;
      background: #eaf3ff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 27px;
    }

    .card h3 {
      margin: 18px 0 5px;
      font-size: 18px;
      color: #111827;
    }

    .card p {
      margin: 0;
      color: #6b7280;
      font-size: 13px;
      line-height: 1.5;
    }

    .card-arrow {
      margin-top: 18px;
      font-size: 13px;
      color: #075dcc;
      font-weight: 700;
    }


    /* =====================================================
       APP VIEW
    ===================================================== */

    .app-view {
      height: 100%;
      display: none;
      flex-direction: column;
      min-height: 0;
    }

    .app-toolbar {
      height: 52px;
      background: white;
      border-bottom: 1px solid #e5e7eb;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 15px;
      flex-shrink: 0;
    }

    .app-name {
      font-size: 14px;
      font-weight: 700;
    }

    .toolbar-buttons {
      display: flex;
      gap: 7px;
    }

    .toolbar-btn {
      border: 1px solid #dbe3ed;
      background: white;
      border-radius: 7px;
      padding: 7px 11px;
      cursor: pointer;
      font-size: 12px;
      color: #374151;
    }

    .toolbar-btn:hover {
      background: #f3f6fa;
    }


    /* =====================================================
       ZOOM
    ===================================================== */

    .zoom-popover {
      display: block;
      position: relative;
    }

    .zoom-toggle {
      border: 1px solid #dbe3ed;
      background: white;
      border-radius: 7px;
      height: 30px;
      min-width: 38px;
      padding: 0 8px;
      cursor: pointer;
      font-size: 13px;
      color: #374151;
      font-weight: 700;
    }

    .zoom-panel {
      display: none;
      position: absolute;
      top: calc(100% + 8px);
      right: 0;
      z-index: 50;
      width: 50px;
      height: 190px;
      padding: 8px 6px;
      background: white;
      border: 1px solid #dbe3ed;
      border-radius: 16px;
      box-shadow: 0 5px 18px rgba(0,0,0,0.14);
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
    }

    .zoom-popover.open .zoom-panel {
      display: flex;
    }

    .zoom-panel-title {
      font-size: 8px;
      font-weight: 700;
      color: #6b7280;
    }

    .zoom-range {
      appearance: none;
      -webkit-appearance: none;
      width: 120px;
      height: 24px;
      margin: 0;
      transform: rotate(-90deg);
      background: transparent;
      cursor: pointer;
    }

    .zoom-range::-webkit-slider-runnable-track {
      height: 4px;
      background: #dbe3ed;
      border-radius: 4px;
    }

    .zoom-range::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 20px;
      height: 20px;
      margin-top: -8px;
      border-radius: 50%;
      background: #075dcc;
      border: 2px solid white;
    }

    .zoom-range::-moz-range-track {
      height: 4px;
      background: #dbe3ed;
      border-radius: 4px;
    }

    .zoom-range::-moz-range-thumb {
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: #075dcc;
      border: 2px solid white;
    }

    .zoom-percent {
      font-size: 9px;
      font-weight: 800;
      color: #075dcc;
      min-width: 32px;
      text-align: center;
    }


    /* =====================================================
       IFRAME
    ===================================================== */

    .frame-container {
      flex: 1;
      min-height: 0;
      position: relative;
      background: white;
      overflow: hidden;
    }

    iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }


    /* =====================================================
       LOADING
    ===================================================== */

    .loading {
      position: absolute;
      inset: 0;
      background: rgba(255,255,255,0.92);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 5;
    }

    .loading-box {
      text-align: center;
      color: #6b7280;
      font-size: 13px;
    }

    .spinner {
      width: 34px;
      height: 34px;
      border: 4px solid #e5e7eb;
      border-top: 4px solid #075dcc;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 12px;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }


    /* =====================================================
       MOBILE
    ===================================================== */

    @media (max-width: 650px) {

      body {
        overflow: hidden;
      }

      .app {
        display: block;
        width: 100%;
        height: 100vh;
      }

      .sidebar {
        display: none;
      }

      .main {
        width: 100%;
        height: 100vh;
      }

      .header {
        height: 62px;
        padding: 0 15px;
      }

      .header-icon {
        font-size: 22px;
      }

      .header-title {
        font-size: 17px;
      }

      .header-right {
        display: none;
      }


      /* MOBILE MENU */

      .mobile-menu {
        display: flex;
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        background: #075dcc;
        padding: 8px 10px;
        gap: 7px;
        flex-shrink: 0;
        scrollbar-width: none;
      }

      .mobile-menu::-webkit-scrollbar {
        display: none;
      }

      .mobile-menu button {
        flex: 0 0 auto;
        border: none;
        background: transparent;
        color: white;
        border-radius: 8px;
        padding: 8px 12px;
        font-size: 12px;
        white-space: nowrap;
        cursor: pointer;
      }

      .mobile-menu button.active {
        background: white;
        color: #075dcc;
        font-weight: 700;
      }


      /* HOME */

      .content {
        padding: 20px 15px;
        overflow-y: auto;
      }

      .welcome {
        margin-bottom: 20px;
      }

      .welcome h1 {
        font-size: 22px;
        line-height: 1.3;
      }

      .welcome p {
        font-size: 13px;
        line-height: 1.5;
      }

      .section-title {
        margin-bottom: 12px;
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
      }

      .card {
        min-height: 165px;
        padding: 15px;
        border-radius: 13px;
      }

      .card-icon {
        width: 40px;
        height: 40px;
        font-size: 21px;
      }

      .card h3 {
        font-size: 14px;
        margin: 12px 0 4px;
      }

      .card p {
        font-size: 10px;
        line-height: 1.4;
      }

      .card-arrow {
        margin-top: 10px;
        font-size: 10px;
      }


      /* APP */

      .app-view {
        height: calc(100vh - 110px);
      }

      .app-toolbar {
        height: 48px;
        padding: 0 10px;
      }

      .app-name {
        font-size: 13px;
      }

      .toolbar-buttons {
        gap: 5px;
      }

      .toolbar-btn {
        padding: 6px 8px;
        font-size: 10px;
      }

      .frame-container {
        width: 100%;
        height: 100%;
      }

      iframe {
        width: 100%;
        height: 100%;
      }

    }


    /* =====================================================
       DESKTOP - MOBILE MENU HIDDEN
    ===================================================== */

    @media (min-width: 651px) {

      .mobile-menu {
        display: none;
      }

    }


    /* =====================================================
       TABLET
    ===================================================== */

    @media (min-width: 651px) and (max-width: 1100px) {

      .sidebar {
        width: 210px;
      }

      .cards {
        grid-template-columns: repeat(2, 1fr);
      }

    }

  </style>

</head>


<body>

<div class="app">


  <!-- ===================================================
       SIDEBAR DESKTOP
  ==================================================== -->

  <aside class="sidebar">

    <div class="brand">

      <div class="brand-title">
        PRAMUNIAGA CENTER
      </div>

      <div class="brand-subtitle">
        Your DS Link Workspace
      </div>

    </div>


    <div class="menu">

      <div class="menu-title">
        Workspace
      </div>


      <button id="menu-home"
              class="active"
              onclick="showHome()">

        <span class="menu-icon">🏠</span>
        <span>Home</span>

      </button>


      <button id="menu-wa"
              onclick="openApp('wa')">

        <span class="menu-icon">💬</span>
        <span>WA Center</span>

      </button>


      <button id="menu-stok"
              onclick="openApp('stok')">

        <span class="menu-icon">📦</span>
        <span>Stok</span>

      </button>


      <button id="menu-katalog"
              onclick="openApp('katalog')">

        <span class="menu-icon">📚</span>
        <span>Katalog</span>

      </button>

    </div>


    <div class="sidebar-footer">
      DS LINK KROYA
    </div>

  </aside>



  <!-- ===================================================
       MAIN
  ==================================================== -->

  <main class="main">


    <!-- HEADER -->

    <header class="header">

      <div class="header-left">

        <div id="headerIcon"
             class="header-icon">
          🏠
        </div>

        <div id="headerTitle"
             class="header-title">
          Home
        </div>

      </div>


      <div class="header-right">
        Your DS Link Workspace
      </div>

    </header>



    <!-- =================================================
         MOBILE MENU
    ================================================== -->

    <nav class="mobile-menu">

      <button id="mobile-home"
              class="active"
              onclick="showHome()">

        🏠 Home

      </button>


      <button id="mobile-wa"
              onclick="openApp('wa')">

        💬 WA Center

      </button>


      <button id="mobile-stok"
              onclick="openApp('stok')">

        📦 Stok

      </button>


      <button id="mobile-katalog"
              onclick="openApp('katalog')">

        📚 Katalog

      </button>

    </nav>



    <!-- =================================================
         HOME
    ================================================== -->

    <section id="homeContent"
             class="content">

      <div class="welcome">

        <h1>
          Selamat Datang di PRAMUNIAGA CENTER 👋
        </h1>

        <p>
          Tools kerja untuk membantu aktivitas pramuniaga DS Link.
        </p>

      </div>


      <div class="section-title">
        Tools Pramuniaga
      </div>


      <div class="cards">


        <!-- WA CENTER -->

        <div class="card"
             onclick="openApp('wa')">

          <div>

            <div class="card-icon">
              💬
            </div>

            <h3>
              WA Center
            </h3>

            <p>
              Kelola komunikasi dan
              aktivitas follow-up customer.
            </p>

          </div>

          <div class="card-arrow">
            Buka WA Center →
          </div>

        </div>



        <!-- STOK -->

        <div class="card"
             onclick="openApp('stok')">

          <div>

            <div class="card-icon">
              📦
            </div>

            <h3>
              Stok
            </h3>

            <p>
              Cek stok produk dan
              informasi barcode DS Link.
            </p>

          </div>

          <div class="card-arrow">
            Buka Stok →
          </div>

        </div>



        <!-- KATALOG -->

        <div class="card"
             onclick="openApp('katalog')">

          <div>

            <div class="card-icon">
              📚
            </div>

            <h3>
              Katalog
            </h3>

            <p>
              Cari produk dan lihat
              informasi produk DS Link.
            </p>

          </div>

          <div class="card-arrow">
            Buka Katalog →
          </div>

        </div>


      </div>

    </section>



    <!-- =================================================
         APP VIEW
    ================================================== -->

    <section id="appView"
             class="app-view">


      <div class="app-toolbar">

        <div id="appName"
             class="app-name">
          Application
        </div>


        <div class="toolbar-buttons">

          <button class="toolbar-btn"
                  onclick="refreshApp()">

            🔄 Refresh

          </button>


          <div class="zoom-popover"
               id="zoomPopover">

            <button type="button"
                    id="zoomToggle"
                    class="zoom-toggle"
                    aria-label="Buka pengaturan zoom"
                    aria-expanded="false">

              🔍

            </button>


            <div class="zoom-panel">

              <div class="zoom-panel-title">
                ZOOM
              </div>

              <input id="zoomRange"
                     class="zoom-range"
                     type="range"
                     min="50"
                     max="120"
                     step="1"
                     value="100"
                     aria-label="Atur zoom">

              <div id="zoomPercent"
                   class="zoom-percent">

                100%

              </div>

            </div>

          </div>


          <button class="toolbar-btn"
                  onclick="openNewTab()">

            ↗ Buka di tab baru

          </button>

        </div>

      </div>



      <div class="frame-container">


        <div id="loading"
             class="loading">

          <div class="loading-box">

            <div class="spinner"></div>

            <div>
              Membuka aplikasi...
            </div>

          </div>

        </div>


        <iframe id="appFrame"
                allow="fullscreen">
        </iframe>


      </div>

    </section>


  </main>

</div>



<script>


  /* =====================================================
     APPLICATION URL
  ===================================================== */

  const apps = {


    wa: {

      name: "WA Center",

      icon: "💬",

      url:
      "https://script.google.com/macros/s/AKfycbxfAyiIQO_gEz1Bz525F5oaIQBmhBARicB0sjyID01B7SHWi8Q2QHluFyZNtCHPT-pk/exec"

    },


    stok: {

      name: "Stok",

      icon: "📦",

      url:
      "https://dslink1602-learning.github.io/stok-ds-link/"

    },


    katalog: {

      name: "Katalog",

      icon: "📚",

      url:
      "https://script.google.com/macros/s/AKfycbxLhf6MuDjchs06WvWtsD4RCFIvcfr4ztQdCnpyLmF8EJIvrfj8kNNnjWIx73VPED3-YA/exec"

    }

  };


  let currentApp = null;
  let currentZoom = 100;



  /* =====================================================
     ZOOM
  ===================================================== */

  function applyZoom() {

    const frame =
      document.getElementById("appFrame");

    const range =
      document.getElementById("zoomRange");

    const percent =
      document.getElementById("zoomPercent");

    const scale =
      currentZoom / 100;

    frame.style.width =
      (100 / scale) + "%";

    frame.style.height =
      (100 / scale) + "%";

    frame.style.transform =
      "scale(" + scale + ")";

    frame.style.transformOrigin =
      "top left";

    if (range)
      range.value = currentZoom;

    if (percent)
      percent.textContent =
        currentZoom + "%";

  }



  function setZoom(value) {

    currentZoom =
      Math.max(
        50,
        Math.min(
          120,
          Number(value) || 100
        )
      );

    applyZoom();

  }



  function closeZoomPopover() {

    const popover =
      document.getElementById("zoomPopover");

    const toggle =
      document.getElementById("zoomToggle");

    if (popover)
      popover.classList.remove("open");

    if (toggle)
      toggle.setAttribute(
        "aria-expanded",
        "false"
      );

  }



  const zoomRange =
    document.getElementById("zoomRange");

  const zoomPopover =
    document.getElementById("zoomPopover");

  const zoomToggle =
    document.getElementById("zoomToggle");



  if (zoomRange) {

    zoomRange.addEventListener(
      "input",
      function () {

        setZoom(this.value);

      }
    );

  }



  if (zoomToggle) {

    zoomToggle.addEventListener(
      "click",
      function (event) {

        event.stopPropagation();

        const open =
          zoomPopover.classList.toggle("open");

        zoomToggle.setAttribute(
          "aria-expanded",
          open ? "true" : "false"
        );

      }
    );

  }



  document.addEventListener(
    "click",
    function (event) {

      if (
        zoomPopover &&
        zoomPopover.classList.contains("open") &&
        !zoomPopover.contains(event.target)
      ) {

        closeZoomPopover();

      }

    }
  );



  /* =====================================================
     SHOW HOME
  ===================================================== */

  function showHome() {

    document.getElementById(
      "homeContent"
    ).style.display = "block";


    document.getElementById(
      "appView"
    ).style.display = "none";


    document.getElementById(
      "headerIcon"
    ).textContent = "🏠";


    document.getElementById(
      "headerTitle"
    ).textContent = "Home";


    setActiveMenu("home");

    currentApp = null;

  }



  /* =====================================================
     OPEN APPLICATION
  ===================================================== */

  function openApp(app) {

    const selected =
      apps[app];

    if (!selected)
      return;


    currentApp = app;

    currentZoom = 100;

    applyZoom();

    closeZoomPopover();


    document.getElementById(
      "homeContent"
    ).style.display = "none";


    document.getElementById(
      "appView"
    ).style.display = "flex";


    document.getElementById(
      "headerIcon"
    ).textContent =
      selected.icon;


    document.getElementById(
      "headerTitle"
    ).textContent =
      selected.name;


    document.getElementById(
      "appName"
    ).textContent =
      selected.name;


    setActiveMenu(app);


    const frame =
      document.getElementById("appFrame");


    const loading =
      document.getElementById("loading");


    loading.style.display =
      "flex";


    frame.onload =
      function () {

        loading.style.display =
          "none";

      };


    frame.src =
      selected.url;

  }



  /* =====================================================
     ACTIVE MENU
  ===================================================== */

  function setActiveMenu(active) {

    const buttons = [
      "home",
      "wa",
      "stok",
      "katalog"
    ];


    buttons.forEach(
      function (item) {

        const desktop =
          document.getElementById(
            "menu-" + item
          );

        const mobile =
          document.getElementById(
            "mobile-" + item
          );


        if (desktop) {

          desktop.classList.remove(
            "active"
          );

        }


        if (mobile) {

          mobile.classList.remove(
            "active"
          );

        }

      }
    );


    const selectedDesktop =
      document.getElementById(
        "menu-" + active
      );


    const selectedMobile =
      document.getElementById(
        "mobile-" + active
      );


    if (selectedDesktop) {

      selectedDesktop.classList.add(
        "active"
      );

    }


    if (selectedMobile) {

      selectedMobile.classList.add(
        "active"
      );

    }

  }



  /* =====================================================
     REFRESH
  ===================================================== */

  function refreshApp() {

    if (!currentApp)
      return;


    const frame =
      document.getElementById(
        "appFrame"
      );


    const loading =
      document.getElementById(
        "loading"
      );


    loading.style.display =
      "flex";


    frame.src =
      apps[currentApp].url;

  }



  /* =====================================================
     OPEN NEW TAB
  ===================================================== */

  function openNewTab() {

    if (!currentApp)
      return;


    window.open(
      apps[currentApp].url,
      "_blank"
    );

  }



  /* =====================================================
     START
  ===================================================== */

  showHome();

</script>


</body>

</html>
